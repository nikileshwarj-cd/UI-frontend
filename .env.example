# ============================================================
# AI Frontend Generation Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Groq API Configuration & Automatic Fallback Keys
# Get free keys at https://console.groq.com
# ----------------------------------------------------------
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEY_FALLBACK=your_secondary_fallback_key_here
# Or comma-separated list of keys: GROQ_API_KEYS=key1,key2,key3

# ----------------------------------------------------------
# Model Selection
# Vision model — must support image input
# Recommended: meta-llama/llama-4-scout-17b-16e-instruct
#              or  meta-llama/llama-4-maverick-17b-128e-instruct
# ----------------------------------------------------------
VISION_MODEL=qwen/qwen3.6-27b

# ----------------------------------------------------------
# Code / Instruction model (no vision required)
# Recommended: llama-3.3-70b-versatile
#              or  llama-3.1-70b-versatile
# ----------------------------------------------------------
CODE_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------
# Output language for generated React components
# Options: tsx  |  jsx
# ----------------------------------------------------------
OUTPUT_LANGUAGE=tsx

# ----------------------------------------------------------
# Output directory (relative to project root)
# ----------------------------------------------------------
OUTPUT_DIR=output

# ----------------------------------------------------------
# Web UI settings
# ----------------------------------------------------------
UI_HOST=127.0.0.1
UI_PORT=5000
UI_DEBUG=false

# ----------------------------------------------------------
# Agent behaviour
# Max retry attempts when LLM returns malformed JSON
# ----------------------------------------------------------
MAX_JSON_RETRIES=3
